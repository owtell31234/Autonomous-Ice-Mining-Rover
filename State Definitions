from enum import Enum

class RoverState(Enum):
    IDLE = 0
    NAVIGATE_TO_SITE = 1
    POSITION_ROVER = 2
    LOWER_BUCKET = 3
    COLLECT_MATERIAL = 4
    CLOSE_DOOR = 5
    RAISE_BUCKET = 6
    RETURN_HOMEBASE = 7
    DUMP_MATERIAL = 8
    RESET_SYSTEM = 9
    COMPLETE = 10
    ERROR = 11

class Rover:
    def __init__(self):
        self.state = RoverState.IDLE
        self.material_collected = False
        self.trap_door_closed = False
        self.bucket_lowered = False
